{
  "name": "pi-startup-picker",
  "version": "0.3.1",
  "description": "Pi extension that lets power users choose provider and model at startup before the session begins.",
  "type": "module",
  "license": "MIT",
  "author": "Keisu",
  "keywords": [
    "pi-package",
    "pi",
    "agent-skill",
    "typescript",
    "model-picker",
    "startup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-startup-picker.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-startup-picker/issues"
  },
  "homepage": "https://github.com/eiei114/pi-startup-picker#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "ROADMAP.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "ci": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "typebox": "latest",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
